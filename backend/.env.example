# backend/.env.example
#
# 이 파일을 backend/.env 로 복사한 뒤 값을 채운다.
#   cp backend/.env.example backend/.env
#
# .env 는 .gitignore 에 걸려 커밋되지 않는다. 이 예시 파일에는 실제 값을
# 절대 넣지 말 것.
#
# 기준은 backend/api_v2 (포트 5002) 다. 레거시 backend/app.py 는 폐기 대상이라
# 맨 아래에 참고용으로만 남겨 두었다.


# =============================================================================
# 신규 DB (api_v2 전용)  — 전부 필수
# =============================================================================

# DB 호스트. 예: localhost
# 주의: localhost 로 두면 MariaDB 커넥터가 포트를 무시하고 유닉스 소켓으로
#       접속한다. 특정 포트를 강제하려면 127.0.0.1 을 쓴다.
V2_DB_HOST=

# DB 포트. 미지정 시 3306
V2_DB_PORT=

# DB 사용자
V2_DB_USER=

# DB 비밀번호
V2_DB_PASSWORD=

# 신규 스키마 DB 이름. 예: caugsa_v2
# 필수. 비워 두면 <DB_NAME>_v2 로 조합되는데, DB_NAME 도 없으면 기본값이
# caugsa_local 이라 caugsa_local_v2 라는 존재하지 않는 DB 를 찾다가 실패한다.
# 반드시 명시할 것.
V2_DB_NAME=


# =============================================================================
# 인증 — 필수
# =============================================================================

# JWT 서명 키. 필수.
# 기본값이 dev-secret-change-me 라 그대로 두면 누구나 토큰을 위조할 수 있다.
# 운영에서는 반드시 교체한다. 생성:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=


# =============================================================================
# 메일 — 배포 필수
# =============================================================================
# 회원가입은 학교 이메일 인증을 강제한다. MAIL_USERNAME 이 없으면 Flask-Mail
# 을 등록하지 않고 인증 코드를 서버 로그에만 남기므로, 사용자가 코드를 받을
# 방법이 없어 회원가입이 아예 불가능하다. 배포 시 필수.

# 발신 계정 (Gmail 이면 전체 주소). 필수
MAIL_USERNAME=

# 앱 비밀번호. 일반 계정 비밀번호가 아니다. 필수
MAIL_PASSWORD=

# SMTP 서버. 선택, 기본값 smtp.gmail.com
MAIL_SERVER=

# SMTP 포트. 선택, 기본값 465 (SSL)
MAIL_PORT=

# SSL 사용 여부. 선택, 기본값 true
MAIL_USE_SSL=

# TLS 사용 여부. 선택, 기본값 false. SSL 과 동시에 켜지 않는다
MAIL_USE_TLS=

# 발신자 표시 주소. 선택, 비우면 MAIL_USERNAME 을 쓴다
MAIL_DEFAULT_SENDER=


# =============================================================================
# 파일 경로
# =============================================================================

# 첨부파일 저장·조회 디렉터리. 절대경로.
# 기본값이 이미 서버 경로(/home/caugsa/caugsa/upload/avanboard_v3)지만,
# 신규 코드를 다른 디렉터리에 배포하므로 명시를 권장한다.
# 기존 파일이 들어 있는 경로를 그대로 가리킬 것. 옮기거나 새로 만들지 않는다.
UPLOAD_DIR=

# 소개 페이지 섹션 이미지 디렉터리. 선택.
# 기본값은 backend 기준 상대경로(../frontend/src/assets/images/02_intro_images)라
# 배포 위치에 따라 엉뚱한 곳을 가리킬 수 있다. 절대경로 지정을 권장한다.
SECTION_IMAGE_DIR=


# =============================================================================
# 기존 회원 재활성화 (한시적 기능)
# =============================================================================
# 이관 회원 6,827명은 비밀번호를 옮기지 않아 전원 로그인 불가 상태다.
# /api/reactivate/* 로 아이디를 입력하면 등록된 이메일로 인증 코드를 보내고
# 새 비밀번호와 누락 정보를 받는다.

# 이메일이 비정상이라 코드를 보낼 수 없는 계정(운영 데이터 기준 2건)이
# 도달할 문의처. 화면 안내문에 그대로 노출된다.
# 비우면 "총학생회 (문의처 미설정)" 이 나가므로 반드시 채운다.
# 예: 총학생회 cau.68.cable@gmail.com
SUPPORT_CONTACT=

# 기능을 끄려면 false. 코드를 지우지 않고 즉시 차단할 때 쓴다.
# 선택, 기본값 true
REACTIVATION_ENABLED=

# 하루 전체 발송 상한. 선택, 기본값 300.
# Gmail 일일 한도(일반 계정 약 500통)를 넘기면 재활성화뿐 아니라 신규 가입
# 인증 메일까지 함께 막히므로 여유를 둔다.
REACTIVATION_DAILY_LIMIT=


# =============================================================================
# 서버
# =============================================================================

# 단독 실행(python -m api_v2.wsgi) 시 포트. 선택, 기본값 5002.
# gunicorn 으로 띄우면 -b 옵션이 우선하므로 의미가 없다.
API_V2_PORT=


# =============================================================================
# 레거시 DB_* (app.py 폐기 대상) — 설정하지 않아도 된다
# =============================================================================
# backend/app.py 와 backend/dbconn.py 가 읽는 값이다. app.py 는 프론트가
# 요구하는 엔드포인트(/api/boards, /api/files/image, PUT /api/events/{id})를
# 구현하지 않아 배포 대상이 아니다.
#
# api_v2 에서는 위 V2_DB_* 가 없을 때의 폴백으로만 쓰인다. V2_DB_* 를 전부
# 채웠다면 아래는 비워 두어도 된다.
#
# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
