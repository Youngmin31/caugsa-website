# CAU_MIGRATION/.env  (이 파일을 .env 로 복사해서 사용)
#
# 값을 비워 두면 caugsa-website/backend/.env 의 DB_* 값을 사용한다.
# 우선순위: 기본값 < caugsa-website/backend/.env < 이 파일 < 환경변수 < CLI 인자

# ----- 소스 DB (기존 caugsa 사이트, 읽기 전용) -----
# SRC_DB_HOST=localhost
# SRC_DB_PORT=3307
# SRC_DB_USER=caugsa_local_user
# SRC_DB_PASSWORD=
# SRC_DB_NAME=caugsa_local

# ----- 타깃 DB (신규 ERD 스키마) -----
# 지정하지 않으면 <소스DB명>_v2 (예: caugsa_local_v2)
# TGT_DB_HOST=localhost
# TGT_DB_PORT=3307
# TGT_DB_USER=caugsa_local_user
# TGT_DB_PASSWORD=
# TGT_DB_NAME=caugsa_v2
